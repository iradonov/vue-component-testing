  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "moduleResolution": "node",
    "types": ["vitest/globals"],
    "lib": ["es6", "dom", "es2021"],
    "skipLibCheck": true
  }
}
